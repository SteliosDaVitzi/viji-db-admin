# Required for Docker Compose saved connections. Generate once, then keep stable:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
WEBDB_VAULT_KEY=
# Nuxt server-to-server API address; never sent to the browser.
NUXT_API_BASE=http://127.0.0.1:34617
# Enable only when serving the frontend over HTTPS.
WEBDB_SECURE_COOKIES=false
# Optional saved connections for non-Docker runs: export these in the backend process environment.
# Use a private writable path and a random 32-byte key encoded as 64 hex characters.
# WEBDB_STORE_PATH=C:/private/webdb/connections.sqlite
# Export WEBDB_VAULT_KEY as well; the local dev launcher does not load .env.
