# Docker Compose saved connections
# Compose creates a persistent named volume automatically:
#   development: dev-connections   production: prod-connections
# Both mount it at /var/lib/webdb inside the backend container and set
# WEBDB_STORE_PATH=/var/lib/webdb/connections.sqlite automatically.
# No Windows/host path or separate database container is needed.
# Set the encryption key below. Generate once, then keep stable across restarts:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
WEBDB_VAULT_KEY=
# Nuxt server-to-server API address; never sent to the browser.
NUXT_API_BASE=http://127.0.0.1:34617
# Enable only when serving the frontend over HTTPS.
WEBDB_SECURE_COOKIES=false
# Non-Docker runs only: export these in the backend process environment.
# Use a private writable path and a random 32-byte key encoded as 64 hex characters.
# Create a private directory first; for example, use $env:LOCALAPPDATA/WebDB on Windows.
# WEBDB_STORE_PATH=C:/Users/YOUR_USER/AppData/Local/WebDB/connections.sqlite
# Export WEBDB_VAULT_KEY as well; the local dev launcher does not load .env.
